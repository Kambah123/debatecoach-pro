    "telegram": "^2.19.8",
    "grammy": "^1.20.0",
    "openai": "^4.24.1",
    "@anthropic-ai/sdk": "^0.24.0",
    "@google/generative-ai": "^0.2.0",
    "langchain": "^0.1.0",
